<% content_for :title, "Post by #{@post.author_member.wallet_address}" %>

<main class="container">
  <div class="breadcrumb">
    <%= link_to "Communities", communities_path %>
    <span class="breadcrumb-sep">/</span>
    <%= link_to @post.community_thread.community.name, @post.community_thread.community %>
    <span class="breadcrumb-sep">/</span>
    <%= link_to @post.community_thread.title, thread_path(@post.community_thread) %>
    <span class="breadcrumb-sep">/</span>
    <span>Post</span>
  </div>

  <section aria-labelledby="post-title">
    <div class="thread-header">
      <h1 id="post-title">Post</h1>
      <p class="meta-line">
        By <%= @post.author_member.wallet_address %>
        &middot; <%= time_tag @post.created_at, @post.created_at.to_fs(:short) %>
      </p>
    </div>

    <article class="panel">
      <div class="post-body-rendered"><%= render_rich_content(@post.body_json, @post.body) %></div>
    </article>

    <div class="actions-row mt-2">
      <% if current_member && (@post.author_member == current_member || current_member.admin?) %>
        <%= link_to "Edit", edit_post_path(@post), class: "button button-secondary" %>
        <%= button_to "Delete", @post, method: :delete, class: "button button-danger", data: { turbo_confirm: "Delete this post?" } %>
      <% end %>
      <% if current_member %>
        <%= link_to "Report", new_post_report_path(@post), class: "button button-danger button-secondary" %>
      <% end %>
    </div>
  </section>

  <section class="mt-2" aria-labelledby="comments-title">
    <h2 id="comments-title">Comments</h2>

    <% if @comments.any? %>
      <%= render partial: "comments/comment", collection: @comments %>
    <% else %>
      <p class="empty-state">No comments yet.</p>
    <% end %>

    <% if current_member %>
      <%= render "comments/form" %>
    <% else %>
      <p class="empty-state"><%= link_to "Sign in", login_path %> to add a comment.</p>
    <% end %>
  </section>
</main>
