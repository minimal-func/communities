<%= form_with model: post, url: post.persisted? ? post_path(post) : thread_posts_path(thread), class: "panel" do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation">
      <p><%= pluralize(post.errors.count, "error") %> prevented this post from being saved:</p>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div
    data-controller="editorjs"
    data-editorjs-placeholder-value="Start typing..."
    data-editorjs-legacy-value="<%= sanitize(post.body, tags: ApplicationHelper::ALLOWED_TAGS, attributes: ApplicationHelper::ALLOWED_ATTRS) if post.body.present? %>"
    class="editor-shell"
  >
    <%= form.label :body_json, "Post", class: "field-label" %>
    <div data-editorjs-target="holder" class="editorjs-holder"></div>
    <%= form.hidden_field :body_json, data: { editorjs_target: "input" } %>
  </div>

  <div class="field">
    <%= form.label :visibility, "Visibility" %>
    <%= form.select :visibility, Post.visibility_options, {}, class: "select-input" %>
  </div>

  <div class="actions-row">
    <%= form.submit %>
  </div>
<% end %>
