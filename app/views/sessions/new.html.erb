<% content_for :title, "Login" %>

<main class="login-shell">
  <section class="login-panel" aria-labelledby="login-title">
    <div class="login-copy">
      <p class="login-kicker"><span aria-hidden="true"></span> Communities</p>
      <h1 id="login-title">Member Login</h1>
      <p class="login-summary">Connect an invited Ethereum wallet to enter the community workspace.</p>

      <ul class="login-highlights" aria-label="Login benefits">
        <li><span aria-hidden="true">01</span>Invitation-only access</li>
        <li><span aria-hidden="true">02</span>Your wallet stays yours</li>
      </ul>

      <%= link_to "Buy me a coffee", "https://buymeacoffee.com/ildar.safin", class: "support-link", target: "_blank", rel: "noopener" %>
    </div>

    <% if current_member %>
      <div class="wallet-card">
        <div class="wallet-card-heading">
          <p class="wallet-label">Session active</p>
          <h2>You’re signed in</h2>
          <p class="wallet-card-copy">This wallet has access to your community workspace.</p>
        </div>

        <div class="wallet-identity">
          <p class="wallet-label">Connected wallet</p>
          <p class="wallet-address"><%= current_member.wallet_address %></p>
        </div>

        <div class="actions-row login-actions">
          <%= button_to "Sign out", session_path, method: :delete, class: "button button-secondary" %>
        </div>
      </div>
    <% else %>
      <form class="wallet-card" data-controller="wallet-login" data-action="submit->wallet-login#submit">
        <div class="wallet-card-heading">
          <p class="wallet-label">Secure access</p>
          <h2>Connect your wallet</h2>
          <p class="wallet-card-copy">Choose a provider, then confirm the signature in your wallet.</p>
        </div>

        <fieldset class="provider-selector">
          <legend>Choose provider</legend>
          <button type="button"
                  class="provider-button provider-active"
                  data-provider-key="browser"
                  data-wallet-login-target="providerButton"
                  data-action="click->wallet-login#selectProvider">
            Browser Wallet
          </button>
          <button type="button"
                  class="provider-button provider-inactive"
                  data-provider-key="walletconnect"
                  data-wallet-login-target="providerButton"
                  data-action="click->wallet-login#selectProvider">
            WalletConnect
          </button>
          <button type="button"
                  class="provider-button provider-inactive"
                  data-provider-key="ledger"
                  data-wallet-login-target="providerButton"
                  data-action="click->wallet-login#selectProvider">
            Ledger
          </button>
        </fieldset>

        <div class="field">
          <label for="wallet_address">Wallet address</label>
          <input
            id="wallet_address"
            name="wallet_address"
            autocomplete="off"
            inputmode="text"
            placeholder="0x..."
            data-wallet-login-target="walletAddress"
          >
        </div>

        <div class="actions-row login-actions">
          <button type="button" class="button-secondary" data-action="wallet-login#connectWallet" data-wallet-login-target="connectButton">
            Connect wallet
          </button>

          <button type="submit" data-wallet-login-target="submitButton">
            Sign in
          </button>
        </div>

        <p class="login-status" data-wallet-login-target="status" role="status" aria-live="polite"></p>
      </form>
    <% end %>
  </section>
</main>
