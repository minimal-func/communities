<%= form_with model: thread, url: thread.persisted? ? thread_path(thread) : community_threads_path(community), class: "panel" do |form| %>
  <% if thread.errors.any? %>
    <div id="error_explanation">
      <p><%= pluralize(thread.errors.count, "error") %> prevented this thread from being saved:</p>
      <ul>
        <% thread.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div
    data-controller="editorjs"
    data-editorjs-placeholder-value="Start typing..."
    data-editorjs-legacy-value="<%= sanitize(thread.body, tags: ApplicationHelper::ALLOWED_TAGS, attributes: ApplicationHelper::ALLOWED_ATTRS) if thread.body.present? %>"
    class="editor-shell"
  >
    <%= form.label :body_json, "Body", class: "field-label" %>
    <div data-editorjs-target="holder" class="editorjs-holder"></div>
    <%= form.hidden_field :body_json, data: { editorjs_target: "input" } %>
  </div>

  <div class="actions-row">
    <%= form.submit %>
  </div>
<% end %>
