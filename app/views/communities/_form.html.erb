<%= form_with model: community, class: "panel" do |form| %>
  <% if community.errors.any? %>
    <div id="error_explanation">
      <p><%= pluralize(community.errors.count, "error") %> prevented this community from being saved:</p>
      <ul>
        <% community.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :slug %>
    <%= form.text_field :slug %>
  </div>

  <div class="field">
    <%= form.label :visibility %>
    <%= form.select :visibility, Community.visibility_options, {}, class: "input" %>
  </div>

  <div
    data-controller="editorjs"
    data-editorjs-placeholder-value="Describe your community..."
    data-editorjs-legacy-value="<%= sanitize(community.description, tags: ApplicationHelper::ALLOWED_TAGS, attributes: ApplicationHelper::ALLOWED_ATTRS) if community.description.present? %>"
    class="editor-shell"
  >
    <%= form.label :description_json, class: "field-label" %>
    <div data-editorjs-target="holder" class="editorjs-holder"></div>
    <%= form.hidden_field :description_json, data: { editorjs_target: "input" } %>
  </div>

  <div class="actions-row">
    <%= form.submit %>
  </div>
<% end %>
