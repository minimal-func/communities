<%= form_with model: Comment.new, url: comments_path, local: true do |form| %>
  <%= form.hidden_field :post_id, value: @post.slug %>

  <div
    data-controller="editorjs"
    data-editorjs-placeholder-value="Write a comment..."
    class="editor-shell"
  >
    <%= form.label :body_json, "Add a comment", class: "field-label" %>
    <div data-editorjs-target="holder" class="editorjs-holder"></div>
    <%= form.hidden_field :body_json, data: { editorjs_target: "input" } %>
  </div>

  <%= form.submit "Post Comment" %>
<% end %>