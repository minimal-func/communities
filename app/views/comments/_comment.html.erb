<article class="panel post-card mb-1 comment comment-depth-<%= depth %>" id="<%= dom_id(comment) %>">
  <p class="meta-line">
    <%= comment.author_member.wallet_address %>
    &middot; <%= time_tag comment.created_at, comment.created_at.to_fs(:short) %>
    <% if current_member && (comment.author_member == current_member || current_member.admin?) %>
      <%= button_to "Delete", comment_path(comment), method: :delete, class: "button button-danger button-small", data: { turbo_confirm: "Delete this comment?" } %>
    <% end %>
    <% if current_member %>
      <%= link_to "Report", new_comment_report_path(comment), class: "button button-danger button-small" %>
    <% end %>
  </p>
  <div class="post-body-rendered"><%= render_rich_content(comment.body_json, comment.body) %></div>

  <% if current_member && comment.can_have_replies? %>
    <details class="comment-reply-toggle">
      <summary>Reply</summary>
      <%= render "comments/reply_form", comment: comment, depth: depth %>
    </details>
  <% end %>

  <% if comment.replies.any? %>
    <div class="comment-replies">
      <%= render partial: "comments/comment", collection: comment.replies, locals: { depth: depth + 1 } %>
    </div>
  <% end %>
</article>
