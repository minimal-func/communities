<% content_for :title, "Join the waitlist" %>

<main class="container">
  <div class="breadcrumb">
    <%= link_to "Communities", root_path %>
    <span class="breadcrumb-sep">/</span>
    <span>Waitlist</span>
  </div>

  <section aria-labelledby="waitlist-title">
    <div class="section-heading">
      <p class="login-kicker text-muted">Invitation-only access</p>
      <h1 id="waitlist-title">Join the waitlist</h1>
    </div>

    <p class="meta-line">
      Membership is by invitation. Tell us the wallet that owns your place and the community
      you’d like to found. An admin will review your proposal. You can check the status of
      your invitation anytime on the
      <%= link_to "status page", waitlist_status_path %>.
    </p>

    <div class="panel mt-2">
      <h2>Request an invitation</h2>
      <% if @entry.errors.any? %>
        <div id="error_explanation">
          <p><%= pluralize(@entry.errors.count, "error") %> prevented this request from being saved:</p>
          <ul>
            <% @entry.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= form_with model: @entry, url: waitlist_path, local: true, class: "inline-form" do |form| %>
        <div class="field">
          <%= form.label :wallet_address, "Wallet Address" %>
          <%= form.text_field :wallet_address, placeholder: "0x...", required: true %>
        </div>
        <div class="field">
          <%= form.label :community_name, "Community name" %>
          <%= form.text_field :community_name, placeholder: "e.g. Greenhaven Commons", required: true %>
        </div>
        <div class="field">
          <%= form.label :community_description, "What is your community about?" %>
          <%= form.text_area :community_description, placeholder: "A short description the admin will review before inviting you.", rows: 3 %>
        </div>
        <div class="actions-row">
          <%= form.submit "Request invitation" %>
        </div>
      <% end %>
    </div>

    <div class="panel mt-2">
      <h2>Already waiting?</h2>
      <p class="text-sm text-muted">
        <%= link_to "Check your invitation status", waitlist_status_path %> by wallet address.
      </p>
    </div>
  </section>
</main>
